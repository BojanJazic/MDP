<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="620.0" prefWidth="922.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.etfbl.org.libraryControllers.SuppliersController">
   <children>
      <HBox prefHeight="520.0" prefWidth="922.0">
         <children>
            <ListView fx:id="lvSuppliersPreview" prefHeight="520.0" prefWidth="212.0" />
            <TableView fx:id="tvBooksPreview" prefHeight="520.0" prefWidth="712.0">
              <columns>
                <TableColumn fx:id="columnID" prefWidth="85.0" text="ID" />
                <TableColumn fx:id="columnTitle" prefWidth="301.0" text="Title" />
                  <TableColumn fx:id="columnAuthor" prefWidth="372.0" text="Author" />
                  <TableColumn fx:id="columnPublicationDate" minWidth="0.0" prefWidth="0.0" text="Release date" />
                  <TableColumn fx:id="columnLanguage" minWidth="0.0" prefWidth="0.0" text="Language" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
         <children>
            <Button fx:id="btnLoadSupplierBooks" mnemonicParsing="false" onAction="#loadSupplierBooks" prefHeight="50.0" prefWidth="170.0" text="Load books">
               <font>
                  <Font size="24.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnOrder" mnemonicParsing="false" onAction="#createOrder" prefHeight="50.0" prefWidth="170.0" text="Order">
               <font>
                  <Font size="24.0" />
               </font>
               <HBox.margin>
                  <Insets left="230.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
