public class LoginController {

	private static PropertiesFileLoader INSTANCE = PropertiesFileLoader.getInstance();
	private static final String SALT = INSTANCE.getSpecifiedProperty("salt");
    private ObservableList<String> messages = FXCollections.observableArrayList();


	public static User user;

	@FXML
	private Button btnLogin;

	@FXML
	private Button btnSgnIn;

	@FXML
	private PasswordField tbPassword;

	@FXML
	private TextField tbUsername;

	@FXML
	void login(ActionEvent event) {

		  String username = tbUsername.getText().trim(); 
		  String password = getHash(tbPassword.getText().trim());
		  
		  
		  if(username.isEmpty() && password.isEmpty()) { 
			  showAlert(); 
		  }else { 
			  try { 
				  URL url = new URL(INSTANCE.getSpecifiedProperty("login_url")); 
				  HttpURLConnection conn = (HttpURLConnection) url.openConnection();
				  
				  conn.setDoOutput(true);
				  conn.setDoInput(true);
				  conn.setRequestMethod("POST");
				  conn.setRequestProperty("Content-Type", "application/json");
				  
				  User user = new User(); 
				  user.setUsername(username);
				  user.setPassword(password);
				  
				  Gson gson = new Gson();
				  
				  try(OutputStreamWriter out = new OutputStreamWriter(conn.getOutputStream(), StandardCharsets.UTF_8)){
		               
		                out.write(gson.toJson(user));
		                out.flush();
		                if(conn.getResponseCode() == HttpURLConnection.HTTP_OK){
		                	
		                	 try(BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(conn.getInputStream()))){
		                         user = gson.fromJson(bufferedReader, User.class);
		                     }
		                	
		                	FXMLLoader loader = new FXMLLoader(LoginController.class.getResource(INSTANCE.getSpecifiedProperty("main_window_fxml")));
		                	Scene scene = new Scene(loader.load());
		                	
		                	MulticastClient multicastClient = new MulticastClient(messages);
		                	multicastClient.start();
		                	
		                	UserMainWindowController controller = loader.getController();
		                	controller.setMessages(messages);
		                	
		                	Stage stage = new Stage();
		                	stage.setTitle("");
		                	stage.setScene(scene);
		                	stage.setResizable(false);
		                	stage.setUserData(user);
		                	stage.show();
		                	
		                } else if (conn.getResponseCode() == HttpURLConnection.HTTP_UNAUTHORIZED) {
		                   new JOptionPane().showMessageDialog(null, "LOGIN NOK");
		                } else{
		                   new JOptionPane().showMessageDialog(null, conn.getResponseCode());
		                }


		            }
				  
				  //zatvaramo konekciju
				  conn.disconnect();
				  } catch (Exception e) {
					  UserLogger.LOGGER.log(Level.SEVERE, "An error occurred while establishing the connection.", e);
				  }
			}
		  
}
		  

	@FXML
	void signIn(ActionEvent event) {
		try {
			FXMLLoader loader = new FXMLLoader(getClass()
					.getResource(PropertiesFileLoader.getInstance().getSpecifiedProperty("registration_fxml")));
			Scene scene = new Scene(loader.load());

			Stage stage = new Stage();
			stage.setTitle("");
			stage.setResizable(false);
			stage.setScene(scene);
			stage.initModality(Modality.APPLICATION_MODAL);

			stage.showAndWait();

		} catch (IOException e) {

		}
	}

	private String getHash(String password) {
		try {
			String inputWithSalt = SALT + password;

			MessageDigest md = MessageDigest.getInstance("SHA-512");
			byte[] hashedBytes = md.digest(inputWithSalt.getBytes());

			return Base64.getEncoder().encodeToString(hashedBytes);

		} catch (NoSuchAlgorithmException e) {
			UserLogger.LOGGER.log(Level.SEVERE, "", e);
			return null;
		}
	}

	private void showAlert() {
		Alert alert = new Alert(AlertType.INFORMATION);
		alert.setTitle("Alert window");
		alert.setContentText("Both fields must be filled!");
		alert.showAndWait();
	}

	public List<User> getAllUsers() {
		List<User> users = new ArrayList<>();
		try {
			// Preuzmi URL API-ja iz config fajla
			String apiUrl = PropertiesFileLoader.getInstance().getSpecifiedProperty("users_url");
			URL url = new URL(apiUrl);

			HttpURLConnection connection = (HttpURLConnection) url.openConnection();
			connection.setRequestMethod("GET");
			connection.setRequestProperty("Accept", "application/json");

			int responseCode = connection.getResponseCode();
			if (responseCode == HttpURLConnection.HTTP_OK) {
				// Ako je odgovor 200, procitaj JSON podatke
				try (BufferedReader in = new BufferedReader(new InputStreamReader(connection.getInputStream()))) {
					StringBuilder response = new StringBuilder();
					String line;
					while ((line = in.readLine()) != null) {
						response.append(line);
					}

					// Parsiraj JSON u listu User objekata
					Gson gson = new Gson();
					Type userListType = new TypeToken<ArrayList<User>>() {
					}.getType();
					users = gson.fromJson(response.toString(), userListType);
				}
			} else if (responseCode == HttpURLConnection.HTTP_NO_CONTENT) {
				System.out.println("No users found.");
			} else {
				System.out.println("Error: " + responseCode);
			}
		} catch (Exception e) {
			e.printStackTrace();
		}
		return users;
	}
	
	
	public void readXML() {
		 try {
	            // Učitajte XML fajl
	            File xmlFile = new File("/UserApp/src/main/resources/users.xml");
	            DocumentBuilderFactory dbFactory = DocumentBuilderFactory.newInstance();
	            DocumentBuilder dBuilder = dbFactory.newDocumentBuilder();
	            Document doc = dBuilder.parse(xmlFile);
	            
	            // Normalizujte dokument (uklanja nepotrebne bele prostore i sl.)
	            doc.getDocumentElement().normalize();

	            System.out.println("Root element: " + doc.getDocumentElement().getNodeName());

	            // Dobijte listu svih <book> elemenata
	            NodeList bookList = doc.getElementsByTagName("book");

	            // Prođite kroz sve <book> elemente
	            for (int i = 0; i < bookList.getLength(); i++) {
	                Element bookElement = (Element) bookList.item(i);

	                // Dohvatite title, author, i year elemente
	                String title = bookElement.getElementsByTagName("title").item(0).getTextContent();
	                String author = bookElement.getElementsByTagName("author").item(0).getTextContent();
	                String year = bookElement.getElementsByTagName("year").item(0).getTextContent();

	                System.out.println("Book:");
	                System.out.println("\tTitle: " + title);
	                System.out.println("\tAuthor: " + author);
	                System.out.println("\tYear: " + year);
	            }
	        } catch (Exception e) {
	            e.printStackTrace();
	        }
	}

