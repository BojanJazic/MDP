package net.etfbl.org.userControllers;

import java.io.IOException;
import java.net.DatagramPacket;
import java.net.DatagramSocket;
import java.net.InetAddress;
import java.net.MulticastSocket;
import java.net.SocketException;
import java.net.UnknownHostException;
import java.util.logging.Level;

import javax.swing.JOptionPane;

import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.control.ListView;
import javafx.scene.control.TextField;
import net.etfbl.org.model.User;
import net.etfbl.org.propertiesLoader.PropertiesFileLoader;
import net.etfbl.org.userLogger.UserLogger;


public class SuggestionsController {
	
	private static PropertiesFileLoader INSTANCE = PropertiesFileLoader.getInstance();
	
	private ObservableList<String> messages = FXCollections.observableArrayList();
	
	private int PORT = Integer.parseInt(INSTANCE.getSpecifiedProperty("multicast_port"));
	
	private User currentUser;
	
	@FXML
    private Button btnAddNewOrder;
	
	@FXML
    private Button btnSendOrder;

    @FXML
    private TextField tbBookTitle;
    
    @FXML
    private ListView<String> lvSuggestionsList;
    

    @FXML
    void addNewOrder(ActionEvent event) {
    	if(!tbBookTitle.getText().isEmpty()) {
    		messages.add(tbBookTitle.getText());
    		lvSuggestionsList.setItems(messages);
    		lvSuggestionsList.refresh();
    		tbBookTitle.clear();
    	}else {
    		new JOptionPane().showMessageDialog(null, "Enter a title!");
    	}
    }
    
    
    //u listu dodam od koga ide poruka i onda dodam ostale narudzbe
	
    @FXML
    void sendOrder(ActionEvent event) {
    	
    	try {
    		InetAddress address = InetAddress.getByName(INSTANCE.getSpecifiedProperty("multicast_host"));
    		
    		String allMessages = String.join("|", messages);
    		
    		byte[] buffer = allMessages.getBytes();
    		
    		try(DatagramSocket socket = new DatagramSocket()){
    			DatagramPacket dp = new DatagramPacket(buffer, buffer.length, address, PORT);
    			
    			socket.send(dp);
    			//System.out.println("Send messages: " + allMessages);
    		}catch(IOException e) {
    			UserLogger.LOGGER.log(Level.SEVERE, "", e);
    		}
    		
    	}catch(UnknownHostException e) {
    		UserLogger.LOGGER.log(Level.SEVERE, "", e);
    	}
    }

	public ObservableList<String> getMessages() {
		return messages;
	}

	public void setMessages(ObservableList<String> messages) {
		this.messages = messages;
		this.lvSuggestionsList.setItems(this.messages);
	}



	public void setCurrentUser(User currentUser) {
		this.currentUser = currentUser;
	}
    
    
    
}
