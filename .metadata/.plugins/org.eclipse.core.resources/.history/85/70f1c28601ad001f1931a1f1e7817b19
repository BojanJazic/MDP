	 @FXML
	 void deleteBook(ActionEvent event) {
		 
		Book selectedBook = tvBookTable.getSelectionModel().getSelectedItem();
		
		if(selectedBook != null) {
			int selectedBookIndex = selectedBook.getId();
		try {
			InetAddress address = InetAddress.getByName("localhost");
			int port = Integer.parseInt(PropertiesFileLoader.getInstance().getSpeciefiedProperty("server_port"));
			
			try(Socket sock = new Socket(address, port)){
				ObjectOutputStream out = new ObjectOutputStream(sock.getOutputStream());
				ObjectInputStream in = new ObjectInputStream(sock.getInputStream());
				
				out.writeObject("DELETE#" + supplier + "#" + selectedBookIndex);
				
				String response = (String)in.readObject();
				
				if("OK".equals(response)) {
					new JOptionPane().showMessageDialog(null, response);
					tvBookTable.refresh();
				}else {
					new JOptionPane().showMessageDialog(null, "Unsuccessfully");
				}
			}
		}catch(ClassNotFoundException | IOException e) {
			SupplierLogger.LOGGER.log(Level.SEVERE, "", e);
		}
	 }else {
		 new JOptionPane().showMessageDialog(null, "First, choose a book!");
	 }

		
	 }

	 //OVO JE ZA CITANJE RABBIT MQ I TREBA DA BUDE U ORDERCONTROLLER KLASI
	 
	private ArrayList<Order> getOrders() {
		Gson gson = new Gson();
		
		ConnectionFactory connFactory = new ConnectionFactory();
		connFactory.setHost(PropertiesFileLoader.getInstance().getSpeciefiedProperty("rabbit_mq"));
		
		try(Connection connection = connFactory.newConnection();
			Channel ch = connection.createChannel()){
			
			ch.queueDeclare(supplier, false, false, false, null);
			
			GetResponse response = ch.basicGet(supplier, true);
			
			if(response != null) {
				String jsonOrder = new String(response.getBody(), StandardCharsets.UTF_8);
				ArrayList<Order> temp = gson.fromJson(jsonOrder, new TypeToken<ArrayList<Order>>() {}.getType());
				
				return temp;
			}

		} catch (Exception e) {
			SupplierLogger.LOGGER.log(Level.SEVERE, "An error occured while getting orders.", e);
		}
		
		return null;
	}
	
