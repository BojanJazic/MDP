	@FXML
	void showAllBooks(ActionEvent event) {

		Task<ObservableList<Book>> task = new Task<>() {
			@Override
			protected ObservableList<Book> call() throws Exception {
				InetAddress addr = InetAddress.getByName("localhost");
				int port = Integer.parseInt(PropertiesFileLoader.getInstance().getSpeciefiedProperty("server_port"));

				try (Socket sock = new Socket(addr, port)) {
					ObjectOutputStream oos = new ObjectOutputStream(sock.getOutputStream());
					ObjectInputStream ois = new ObjectInputStream(sock.getInputStream());

					oos.writeObject("LOAD_ALL_BOOKS#" + supplier);
					ArrayList<Book> books = (ArrayList<Book>) ois.readObject();
					
					if(!books.isEmpty())
						return FXCollections.observableArrayList(books);
					else
						return FXCollections.observableArrayList(new ArrayList<Book>());

				}

			}
		};

		task.setOnSucceeded(e -> tvBookTable.setItems(task.getValue()));
		task.setOnFailed(e -> System.out.println("Failed to load books: " + task.getException()));

		new Thread(task).start();
	}

