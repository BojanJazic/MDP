package net.etfbl.org.rmi;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.io.Writer;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.rmi.RemoteException;
import java.rmi.registry.LocateRegistry;
import java.rmi.registry.Registry;
import java.rmi.server.UnicastRemoteObject;
import java.util.logging.Level;

import com.google.gson.Gson;


import net.etfbl.org.billModel.Bill;
import net.etfbl.org.propertiesLoader.PropertiesFileLoader;
import net.etfbl.org.supplierLogger.SupplierLogger;

public class RMIService implements RMIServiceInterface {
		
	
	private static PropertiesFileLoader instance = PropertiesFileLoader.getInstance();
	
	@Override
	public double saveBill(Bill bill) throws RemoteException {
		
		billSerialization(bill);
		
		double tax = Double.parseDouble(instance.getSpeciefiedProperty("tax"));
		double taxToPay = bill.getPrice() * tax;
		
		BigDecimal bd = new BigDecimal(taxToPay);
		BigDecimal roundedValue = bd.setScale(2, RoundingMode.HALF_UP);
		
		return roundedValue.doubleValue();
	}
	
	
	private void billSerialization(Bill bill) {
		String uniqueName = bill.getDate().toString();
		File file = new File(instance.getSpeciefiedProperty("bills") + instance.getSpeciefiedProperty("bill_start") + uniqueName + ".json");
		
		try(Writer writer = new FileWriter(file)) {
			Gson gson = new Gson();
			gson.toJson(bill, writer);
		} catch (IOException e) {
			SupplierLogger.LOGGER.log(Level.SEVERE, "An error occured during bill serialization.", e);
		}
	}
	
	
	public static void main(String[] args) {
		try {
			RMIService server = new RMIService();
			RMIServiceInterface stub = (RMIServiceInterface) UnicastRemoteObject.exportObject(server, 0);
			Registry registry = LocateRegistry.createRegistry(Integer.valueOf(instance.getSpeciefiedProperty("rmi_port")));
			registry.rebind("RMIService", stub);
			System.out.println("RMI server started.");
		} catch (Exception e) {
			// TODO: handle exception
			SupplierLogger.LOGGER.log(Level.SEVERE, "An error occured while starting RMIService.", e);
		}
	}
}
