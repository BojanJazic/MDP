    @FXML
    void downloadBooks(ActionEvent event) {
    	
    	booksForDownload = tvBookTable.getItems().stream()
    										 .filter(b -> b.getSelected())
    										 .collect(Collectors.toCollection(ArrayList::new));
    		
    	
    	if(!booksForDownload.isEmpty()) {
    		String userMail = currentUser.getEmail();
    		new Thread(() -> {
    			try {
    				URL url = new URL(INSTANCE.getSpecifiedProperty("mail_url") + userMail);
    				HttpURLConnection conn = (HttpURLConnection) url.openConnection();
    				
    				conn.setDoOutput(true);
    				conn.setRequestMethod("POST");
    				conn.setRequestProperty("Content-Type", "application/json");
    				
    				Gson gson = new Gson();

    				try(OutputStreamWriter out = new OutputStreamWriter(conn.getOutputStream(), StandardCharsets.UTF_8)){
    					out.write(gson.toJson(booksForDownload));
    					out.flush();
    					
    					
    					if(conn.getResponseCode() == HttpURLConnection.HTTP_OK) {
    						new JOptionPane().showMessageDialog(null, "Endpoint radi");
    					}else {
    						new JOptionPane().showMessageDialog(null, "Endpoint ne radi");
    					}
    				}
    				
    				
				} catch (Exception e) {
					UserLogger.LOGGER.log(Level.SEVERE, "", e);
				}
    			
    		}).start();
    		
    	}
    	
    }
    
    
