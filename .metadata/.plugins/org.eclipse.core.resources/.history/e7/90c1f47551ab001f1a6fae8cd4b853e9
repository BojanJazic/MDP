public class ChatController implements Initializable{

	private static PropertiesFileLoader INSTANCE = PropertiesFileLoader.getInstance();
	private String address = INSTANCE.getSpecifiedProperty("keystore_host");
	private int port = Integer.parseInt(INSTANCE.getSpecifiedProperty("keystore_port"));
	
	
	{
		System.setProperty("javax.net.ssl.trustStore", INSTANCE.getSpecifiedProperty("keystore_path"));
		System.setProperty("javax.net.ssl.trustStorePassword", INSTANCE.getSpecifiedProperty("keystore_pass"));
	}
	

    @FXML
    private Button btnReadMessage;

    @FXML
    private Button btnSendMessage;

    @FXML
    private ListView<String> lvUsersList;

    @FXML
    private TextArea taChatContent;

    @FXML
    private TextField tbInputField;
    
    private ArrayList<User> users = new ArrayList<User>();
    private ObservableList<String> obsUsers = FXCollections.observableArrayList();
    
    private String currentUser;

    @Override
    public void initialize(URL location, ResourceBundle resources) {
    	try {
			URL url = new URL(INSTANCE.getSpecifiedProperty("users_url"));
			HttpURLConnection conn = (HttpURLConnection) url.openConnection();
			
			conn.setDoOutput(true);
			conn.setRequestMethod("GET");
			conn.setRequestProperty("Content-Type", "application/json");
			
			if(conn.getResponseCode() == HttpURLConnection.HTTP_OK) {
				try(BufferedReader br = new BufferedReader(new InputStreamReader(conn.getInputStream(), StandardCharsets.UTF_8))){
					StringBuilder builder = new StringBuilder();
					String responseLine;
					
					while((responseLine = br.readLine()) != null) {
						builder.append(responseLine.trim());
					}
					
					ObjectMapper mapper = new ObjectMapper();
					users = mapper.readValue(builder.toString(), new TypeReference<ArrayList<User>>() {});
					
					for(User u : users) {
						obsUsers.add(u.getUsername());
					}
					
					lvUsersList.setItems(obsUsers);
				}
			}else if(conn.getResponseCode() == HttpURLConnection.HTTP_NO_CONTENT) {
				new JOptionPane().showMessageDialog(null, conn.getResponseCode());
			}else {
				new JOptionPane().showMessageDialog(null, conn.getResponseCode());
			}
			
			
			
		} catch (Exception e) {
			UserLogger.LOGGER.log(Level.SEVERE, "", e);
		}
    	
    }
    
    
    @FXML
    void readMessage(ActionEvent event) {
    	String selectedUser = lvUsersList.getSelectionModel().getSelectedItem();
    	
    	if(selectedUser != null) {
    		SSLSocketFactory socketFactory = (SSLSocketFactory) SSLSocketFactory.getDefault();
    		try(SSLSocket socket = (SSLSocket) socketFactory.createSocket(address, port)){
    			
    			ObjectOutputStream output = new ObjectOutputStream(socket.getOutputStream());
    			ObjectInputStream input = new ObjectInputStream(socket.getInputStream());
    			
    			output.writeObject("MESSAGE#" + currentUser + "#" + selectedUser);
    			
    			ArrayList<Message> conversation = (ArrayList<Message>) input.readObject();
    			
    			
    			
    			
    		}catch (IOException | ClassNotFoundException e) {
				// TODO: handle exception
			}
    	}
    }

