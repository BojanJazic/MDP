		            // Obeleži selektovane redove
		            if (change.wasAdded()) {
		                for (Book book : change.getAddedSubList()) {
		                    book.setSelected(true);
		                }
		            }
		            // Poništi selekciju redova koji više nisu selektovani
		            if (change.wasRemoved()) {
		                for (Book book : change.getRemoved()) {
		                    book.setSelected(false);
		                }
		            }
		        }
		        tvBooksPreview.refresh(); // Osveži prikaz nakon promene
		    });
		
		
		getSuppliers();
		
    }
    
    
