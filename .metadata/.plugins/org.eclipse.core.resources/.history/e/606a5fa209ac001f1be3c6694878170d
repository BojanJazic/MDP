    private void sendOrder(Order order, String selectedSupplier) {
    	ConnectionFactory connFactory = new ConnectionFactory();
    	connFactory.setHost(INSTANCE.getSpecifiedProperty("rabbit_mq_address"));
    	
    	try(Connection conn = connFactory.newConnection()){
    		Channel channel = conn.createChannel();
    		
    		channel.queueDeclare(selectedSupplier, false, false, false, null);
    		
    		ByteArrayOutputStream byteOut = new ByteArrayOutputStream();
    		ObjectOutputStream output = new ObjectOutputStream(byteOut);
    		
    		output.writeObject(order);
    		output.flush();
    		
    		byte[] messageBody = byteOut.toByteArray();
    		
    		channel.basicPublish("", selectedSupplier, null, messageBody);
    		
    		new JOptionPane().showMessageDialog(null, "POSLATO");
    		
    		
    	}catch(IOException | TimeoutException e) {
    		LibraryLogger.LOGGER.log(Level.SEVERE, "An error occured while sending order.");
    	}
    	
    }
    

    @FXML
    void loadSupplierBooks(ActionEvent event) {
    	String selectedSupplier = lvSuppliersPreview.getSelectionModel().getSelectedItem();
    	
    	if(selectedSupplier != null) {
    		try {
				InetAddress address = InetAddress.getByName(host);
				
				try(Socket socket = new Socket(address, port)){
					ObjectOutputStream output = new ObjectOutputStream(socket.getOutputStream());
					ObjectInputStream input = new ObjectInputStream(socket.getInputStream());
					
					output.writeObject("BOOKS_BY_SUPPLIER#" + selectedSupplier);
					output.flush();
					
					ArrayList<Book> books = (ArrayList<Book>)input.readObject();
					
					tvBooksPreview.setItems(FXCollections.observableArrayList(books));
				}
			} catch (Exception e) {
				e.printStackTrace();
				LibraryLogger.LOGGER.log(Level.SEVERE, "", e);
			}
    	}
    }
    
    @FXML
    void addItemToList(ActionEvent event) {
    	Book selectedBook = tvBooksPreview.getSelectionModel().getSelectedItem();
    	
    	if(selectedBook != null) {
    		orderList.add(new OrderItem(selectedBook));
    	}
    }
    
    private void getSuppliers() {
    	try {
			InetAddress address = InetAddress.getByName(host);
			try(Socket socket = new Socket(address, port)){
				ObjectOutputStream output = new ObjectOutputStream(socket.getOutputStream());
				ObjectInputStream input = new ObjectInputStream(socket.getInputStream());
				
				output.writeObject("GET_SUPPLIERS");
				output.flush();
				
				suppliers = (ArrayList<String>)input.readObject();
				
				obsSuppliers = FXCollections.observableArrayList(suppliers);
				
				lvSuppliersPreview.setItems(obsSuppliers);
			}
		} catch (Exception e) {
			System.out.println(e.getMessage());
			LibraryLogger.LOGGER.log(Level.SEVERE, "", e);
		}
    }
	
