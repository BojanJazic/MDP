package net.etfbl.org.zipper;

import java.io.BufferedWriter;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.ArrayList;
import java.util.logging.Level;
import java.util.zip.ZipEntry;
import java.util.zip.ZipOutputStream;

import net.etfbl.org.logger.LibraryServerLogger;
import net.etfbl.org.model.Book;
import net.etfbl.org.propertiesLoader.PropertiesFileLoader;

public class BookZipper {
	
	
	public File zipBooks(ArrayList<Book> books) {
		String currentDateTime = String.valueOf(System.currentTimeMillis());
		String prop = PropertiesFileLoader.getInstance().getSpeciefiedProperty("zipped_name_starts");
		
		String fileName = prop + currentDateTime + ".zip";
		
		
		try {
			File zipFile = new File(fileName);
			ArrayList<File> filesToZip = new ArrayList<File>();
			
			
			try(ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
				
				for(Book b : books) {
					File bookFile = getBookFile(b, b.getId());
					
					if(bookFile != null) {
						filesToZip.add(bookFile);
						
						try(FileInputStream fis = new FileInputStream(bookFile)) {
							ZipEntry zipEntry = new ZipEntry(bookFile.getName());
							
							zos.putNextEntry(zipEntry);
							
							byte[] buffer = new byte[1024];
							int len;
							
							while((len = fis.read(buffer)) > 0) {
								zos.write(buffer, 0, len);
							}
							
							zos.closeEntry();
						} 
					}
				}
				
				zos.finish();
				
			} 
			
			return zipFile;
			
		} catch (Exception e) {
			LibraryServerLogger.LOGGER.log(Level.SEVERE, "", e);
			return null;
		}
		

	}
	
    private File getBookFile(Book book, int id) {
    	String dir = PropertiesFileLoader.getInstance().getSpeciefiedProperty("downloaded_books_dir");
        File file = new File(dir + book.getBookTitle() + "__" + book.getId() + ".txt");

        try (PrintWriter printWriter = new PrintWriter(new BufferedWriter(new FileWriter(file)))) {
            // Zapisivanje podataka o knjizi u fajl (pretpostavljamo da Book ima metod toString)
            printWriter.println(book.toString());
        } catch (IOException e) {
            return null;
        }

        return file;
    }
	
	
}
