	 private void getNextOrder() {
		 if(!orderList.isEmpty()) {
			 
			 //OVDJE NECE DA OCISTI PRETHODNE ZAPISE
			 
			 Platform.runLater(() -> lvOrderPreview.getItems().clear());
			 //lvOrderPreview.getItems().clear();
			 Order nextOrder = orderList.get(ORDER_NUMBER);
			 lvOrderPreview.setItems(FXCollections.observableArrayList(nextOrder.getOrderItems()));
			 orderList.remove(ORDER_NUMBER);
		 }else {
			 lvOrderPreview.getItems().clear();
			 showAlert();
		 }
		 

	 }
	 
	 private boolean send(Book book) {
		 boolean bookExists = false;
		 try {
			 URL bookURL = new URL(INSTANCE.getSpeciefiedProperty("books_url"));
			 HttpURLConnection conn = (HttpURLConnection) bookURL.openConnection();
			 conn.setDoOutput(true);
			 conn.setRequestMethod("POST");
			 conn.setRequestProperty("Content-Type", "application/json");
			 
			 Gson gson = new Gson();
			 
			 try(OutputStreamWriter out = new OutputStreamWriter(conn.getOutputStream(), StandardCharsets.UTF_8)){
					out.write(gson.toJson(book));
					out.flush();
					
				 
				  if(conn.getResponseCode() == HttpURLConnection.HTTP_CREATED) {
					  System.out.println("Book added!");
					  

				  } else {
					  System.out.println("Book already exists!");
					  bookExists = true;
				  }
				 
			 }
	 
		 }catch (Exception e) {
			 SupplierLogger.LOGGER.log(Level.SEVERE, "", e);
		}
		 return bookExists;
	 }
	 
	 private double sendBillToBookkeepingService(Bill bill) {
		 try {
			Registry registry = LocateRegistry.getRegistry(Integer.parseInt(INSTANCE.getSpeciefiedProperty("rmi_port")));
			RMIServiceInterface rmi = (RMIServiceInterface)registry.lookup(INSTANCE.getSpeciefiedProperty("rmi_name"));
			double tax = rmi.saveBill(bill);
			return tax;
		} catch (RemoteException | NotBoundException e) {
			SupplierLogger.LOGGER.log(Level.SEVERE, "An error occured in method sendBillToBookkeepingService(Bill bill).", e);
			return 0.0;
		}
		 
	 }
	 
	 
	 private void getAllOrders() {
		 
 		 ConnectionFactory connFactory = new ConnectionFactory();
		 connFactory.setHost(INSTANCE.getSpeciefiedProperty("rabbit_mq"));
		 
		 try(Connection conn = connFactory.newConnection()){
			 Channel channel = conn.createChannel();
			 
			 channel.queueDeclare(currentSupplier, false, false, false, null);
			 
			 boolean autoAck = false;
			 
			 GetResponse response;
			 
			 while((response = channel.basicGet(currentSupplier, autoAck)) != null) {
				 byte[] body = response.getBody();
				 
				 ByteArrayInputStream byteInput = new ByteArrayInputStream(body);
				 ObjectInputStream input = new ObjectInputStream(byteInput);
				 Order order = (Order)input.readObject();
				 
				 orderList.add(order);
				 channel.basicAck(response.getEnvelope().getDeliveryTag(), false);	// Potvrđivanje prijema
			 }
			
		lvOrderPreview.setItems(FXCollections.observableArrayList(orderList.get(ORDER_NUMBER).getOrderItems()));
		orderList.remove(ORDER_NUMBER);
		 }catch(Exception e){
			 SupplierLogger.LOGGER.log(Level.SEVERE, "", e);
		 }
			 
	 }
	 
	 
