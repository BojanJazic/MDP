package net.etfbl.org.chat;

import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.util.ArrayList;
import java.util.logging.Level;

import javax.net.ssl.SSLSocket;

import net.etfbl.org.model.Message;
import net.etfbl.org.userLogger.UserLogger;

public class ChatServerThread extends Thread {
	
	private static Object LOCK = new Object();
	
	ObjectOutputStream output;
	ObjectInputStream input;
	ArrayList<Message> messages = new ArrayList<Message>();
	SSLSocket socket;
	
	
	public ChatServerThread(SSLSocket sock, ArrayList<Message> messages) {
		this.socket = sock;
		this.messages = messages;
		try {
			this.output = new ObjectOutputStream(socket.getOutputStream());
			this.input = new ObjectInputStream(socket.getInputStream());
		}catch(IOException e) {
			UserLogger.LOGGER.log(Level.SEVERE, "", e);
		}
	}
	
	
	@Override
	public void run() {
		try {
			String request = (String)input.readObject();
			
			if(request.startsWith("GET_MESSAGES")) {
				String[] parts = request.split("#");
				String recipient = parts[1];
				String sender = parts[2];
				ArrayList<Message> requestedConversation = new ArrayList<Message>();
				
				for(Message message : messages) {
					if(message.getRecipient().equals(recipient) && message.getSender().equals(sender) 
					   || message.getRecipient().equals(sender) && message.getSender().equals(recipient)) {
						
					}
				}
				
				
			}else if(request.startsWith("SEND_MESSAGE")) {
				Message message = (Message)input.readObject();
				
				synchronized (LOCK) {
					messages.add(message);
				}
			}
			
			
			output.close();
			input.close();
			socket.close();
			
		}catch(Exception e) {
			
		}
	}

}
